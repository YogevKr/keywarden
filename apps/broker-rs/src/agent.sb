(version 1)
(deny default)
(allow process-fork)
(allow process-exec)
(allow signal (target self))
(allow sysctl-read)
(allow file-read-metadata)
(allow file-read* (literal "/"))
(allow file-read* file-map-executable
  (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin")
  (subpath "/Library/Apple") (subpath "/opt/homebrew")
  (subpath (param "TOOLS"))
  (subpath (param "WORKSPACE")) (subpath (param "RUNTIME"))
  (literal (param "CLIENT"))
  (literal "/private/etc/hosts") (literal "/private/etc/resolv.conf")
  (literal "/private/etc/localtime") (subpath "/private/var/db/timezone"))
(allow file-write* (subpath (param "WORKSPACE")) (subpath (param "RUNTIME")))
(allow file-read* file-write-data file-ioctl
  (literal "/dev/null") (literal "/dev/zero") (literal "/dev/random")
  (literal "/dev/urandom") (literal "/dev/tty") (regex #"^/dev/ttys[0-9]+$"))
(allow file-read* file-write-data (literal (param "SOCKET")))
(allow network-outbound (literal (param "SOCKET")))
(allow network-outbound (remote tcp "*:443") (remote udp "*:53"))
(deny network-outbound (remote tcp "localhost:*") (remote udp "localhost:*"))
(allow mach-lookup
  (global-name "com.apple.system.logger")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.mDNSResponder")
  (global-name "com.apple.bsd.dirhelper"))
(deny process-exec (literal (param "OPGATE")) (literal (param "OP")))
