[
  {
    "name": "keywarden_request_access",
    "description": "Manage 1Password access through Keywarden. Keywarden identifies Codex, Claude Code, or another MCP client from the MCP handshake. Request iPhone approval for personal or work vaults. The existing agent scope uses the agents vault without approval. Supply a task and reason as approval intent. Supply vaults or allVaults. Sessions allow read and list by default. Supply operations to request a narrower scope. Do not put secret values in the intent. MCP tools execute read and list only. Write, create, and delete scopes are for the CLI; no MCP item mutation tools exist.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string",
          "enum": [
            "agent",
            "personal",
            "work"
          ]
        },
        "allVaults": {
          "type": "boolean",
          "default": false
        },
        "vaults": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read",
              "list",
              "write",
              "create",
              "delete"
            ]
          },
          "minItems": 1,
          "default": [
            "read",
            "list"
          ],
          "description": "MCP executes read and list. Write, create, and delete apply only to CLI operations."
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "default": 900
        },
        "idleTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "default": 300
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why this access is needed."
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "description": "The task that needs 1Password access."
        },
        "sessionName": {
          "type": "string",
          "minLength": 1,
          "description": "Optional session label when the MCP host does not provide one."
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "Optional display override. The MCP client identity is used by default."
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "Optional host display override. The local host is used by default."
        },
        "waitSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25,
          "default": 0,
          "description": "Wait 0-25 seconds per call. Repeat the same call or access_status for a longer wait."
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Optional task session ID when the host does not supply it. Display metadata only; never invent an ID."
        }
      },
      "required": [
        "account",
        "reason"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "scope": {
          "type": "object"
        },
        "leaseId": {
          "type": [
            "string",
            "null"
          ]
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "idleUntil": {
          "type": [
            "string",
            "null"
          ]
        },
        "client": {
          "type": [
            "object",
            "null"
          ]
        },
        "intent": {
          "type": [
            "object",
            "null"
          ]
        },
        "delivery": {
          "type": [
            "object",
            "null"
          ],
          "description": "Relay, Apple acceptance, and polling status. Apple acceptance is not proof of phone delivery."
        }
      },
      "required": [
        "requestId",
        "status",
        "scope",
        "leaseId",
        "expiresAt",
        "idleUntil",
        "client",
        "intent"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "keywarden_access_status",
    "description": "Report local permissions without calling 1Password by default. providerCheck=not_performed means no connectivity check ran. Set checkProvider=true to check fresh vault metadata through existing list access, optionally for one account. Checks never request approval, read fields, or renew leases. Per-account results are ok, failed, or skipped; ok covers metadata only. Each account command has an eight-second timeout. Do not combine checkProvider with requestId or waitSeconds. Supply requestId to poll one approval with waitSeconds (0-25).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "waitSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25,
          "default": 0,
          "description": "Wait 0-25 seconds per call. Repeat the same call or access_status for a longer wait."
        },
        "checkProvider": {
          "type": "boolean",
          "default": false,
          "description": "Check provider connectivity using existing list access. Never creates an approval request."
        },
        "account": {
          "type": "string",
          "enum": [
            "agent",
            "personal",
            "work"
          ],
          "description": "Check this account only. Requires checkProvider=true. Omit to check all three accounts."
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "scope": {
              "type": "object"
            },
            "leaseId": {
              "type": [
                "string",
                "null"
              ]
            },
            "expiresAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "idleUntil": {
              "type": [
                "string",
                "null"
              ]
            },
            "client": {
              "type": [
                "object",
                "null"
              ]
            },
            "intent": {
              "type": [
                "object",
                "null"
              ]
            },
            "delivery": {
              "type": [
                "object",
                "null"
              ],
              "description": "Relay, Apple acceptance, and polling status. Apple acceptance is not proof of phone delivery."
            }
          },
          "required": [
            "requestId",
            "status",
            "scope",
            "leaseId",
            "expiresAt",
            "idleUntil",
            "client",
            "intent"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "ready"
            },
            "accounts": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "mcpOperations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "providerCheck": {
              "type": "string",
              "enum": [
                "not_performed",
                "completed"
              ]
            }
          },
          "required": [
            "status",
            "accounts",
            "mcpOperations",
            "providerCheck"
          ],
          "additionalProperties": false
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "keywarden_read_secret",
    "description": "Read a 1Password field through the local broker. The agent scope needs no approval. Personal and work calls request exact access when no lease matches. Pass structuredContent.value directly to the consumer. Pending approval returns isError=false with status=pending and requestId. Repeat the same call after approval; no operation has run while pending.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "enum": [
            "auto",
            "agent",
            "personal",
            "work"
          ],
          "default": "auto"
        },
        "leaseId": {
          "type": "string",
          "default": "active"
        },
        "requestIfNeeded": {
          "type": "boolean",
          "default": true,
          "description": "Create an exact phone approval request when no matching lease exists."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why this field is needed. The broker supplies a safe default."
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "description": "Task label shown on the phone."
        },
        "waitSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25,
          "default": 25,
          "description": "Wait 0-25 seconds per call. Repeat the same call or access_status for a longer wait."
        }
      },
      "required": [
        "reference"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "reference",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "pending"
            },
            "requestId": {
              "type": "string"
            },
            "delivery": {
              "type": [
                "object",
                "null"
              ]
            },
            "retryAfterSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "next": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "requestId",
            "delivery",
            "retryAfterSeconds",
            "next"
          ],
          "additionalProperties": false
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "keywarden_list_items",
    "description": "List or search item metadata in an approved vault. Returns only IDs, titles, and categories. Supports vault names or IDs and cursor pagination. Agent access needs no approval. Personal and work calls request list access when needed. waitSeconds accepts 0-25. Pending approval returns isError=false with status=pending and requestId. Repeat the same call after approval; no operation has run while pending.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "vault": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "enum": [
            "auto",
            "agent",
            "personal",
            "work"
          ],
          "default": "auto"
        },
        "leaseId": {
          "type": "string",
          "default": "active"
        },
        "requestIfNeeded": {
          "type": "boolean",
          "default": true,
          "description": "Create an exact phone approval request when no matching lease exists."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why item metadata is needed. The broker supplies a safe default."
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "description": "Task label shown on the phone."
        },
        "waitSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25,
          "default": 25,
          "description": "Wait 0-25 seconds per call. Repeat the same call or access_status for a longer wait."
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Case-insensitive search of returned metadata only."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 100
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "description": "Use nextCursor from the previous page. Keep the same account, vault, and query."
        }
      },
      "required": [
        "vault"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "vault": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "totalCount": {
              "type": "integer"
            },
            "nextCursor": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "vault",
            "items",
            "totalCount",
            "nextCursor"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "pending"
            },
            "requestId": {
              "type": "string"
            },
            "delivery": {
              "type": [
                "object",
                "null"
              ]
            },
            "retryAfterSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "next": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "requestId",
            "delivery",
            "retryAfterSeconds",
            "next"
          ],
          "additionalProperties": false
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    }
  },
